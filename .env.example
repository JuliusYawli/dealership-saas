# Copy this file to .env and fill values
# Supabase: Project Settings -> Database -> Connection string
# DATABASE_URL = "Transaction" pooler connection (port 6543, pgbouncer=true) - used at runtime
# DIRECT_URL   = "Session"/direct connection (port 5432) - used by `prisma migrate`
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# NextAuth - generate NEXTAUTH_SECRET with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

S3_REGION="us-east-1"
S3_BUCKET="your-bucket"
S3_ACCESS_KEY_ID="your-access-key"
S3_SECRET_ACCESS_KEY="your-secret-key"
